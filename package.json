{
  "name": "@xingchenyd/random-design",
  "version": "0.1.0",
  "description": "Procedural visual systems for websites and presentations. Diverse directions, reproducible rules, portable history.",
  "type": "module",
  "license": "MIT",
  "author": "xingchenyd",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingchenyd/random-design.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "random-design": "src/cli.js",
    "random-design-mcp": "src/mcp.js"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./render": "./src/render.js",
    "./pptx": "./src/pptx.js"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build",
    "studio": "node scripts/serve.js",
    "examples": "node scripts/examples.js",
    "benchmark": "node scripts/benchmark.js",
    "test:browser": "node scripts/browser-check.js",
    "test:mcp": "node scripts/mcp-check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/hashes": "2.4.0",
    "culori": "4.0.2",
    "pptxgenjs": "4.0.1",
    "proper-lockfile": "^4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jszip": "^3.10.1",
    "playwright": "^1.56.1"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
